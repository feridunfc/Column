{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/feridunfc/Column/blob/main/docs/rule_cards/schema/rule-card.schema.json",
  "title": "Column Engineering Rule Card",
  "type": "object",
  "required": [
    "schema_version",
    "rule_id",
    "revision",
    "title",
    "category",
    "normative_state",
    "implementation_state",
    "normative_basis",
    "inputs",
    "equations",
    "decision",
    "engineering_notes",
    "required_evidence",
    "verification"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "rule_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 5},
    "category": {"type": "string", "minLength": 2},
    "normative_state": {"type": "string", "minLength": 2},
    "implementation_state": {"type": "string", "minLength": 2},
    "scope": {"type": "object"},
    "normative_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["document", "clause", "equations", "source"],
        "properties": {
          "document": {"type": "string"},
          "clause": {"type": "string"},
          "equations": {"type": "array", "items": {"type": "string"}},
          "source": {"type": "string", "format": "uri"}
        },
        "additionalProperties": true
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "unit", "required"],
        "properties": {
          "name": {"type": "string"},
          "type": {"type": "string"},
          "unit": {"type": ["string", "null"]},
          "required": {"type": "boolean"},
          "evidence": {"type": "string"},
          "required_if": {"type": "string"},
          "values": {"type": "array"}
        },
        "additionalProperties": true
      }
    },
    "equations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "expression"],
        "properties": {
          "id": {"type": "string"},
          "expression": {"type": "string", "minLength": 2},
          "symbols": {"type": "object"},
          "units_check": {"type": "string"},
          "clause": {"type": "string"},
          "applicability": {"type": "string"},
          "meaning": {"type": "string"},
          "gamma_branch": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "decision": {"type": "object"},
    "engineering_notes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verification": {
      "type": "object",
      "required": ["hand_cases", "independent_review_required"],
      "properties": {
        "hand_cases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "independent_review_required": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
